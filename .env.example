# ============================================
# RAGForge Environment Configuration
# ============================================

# Storage Mode: 'sqlite' (default, local) or 'postgres' (docker production)
STORAGE_MODE=sqlite

# PostgreSQL (required when STORAGE_MODE=postgres)
POSTGRES_URL=postgres://ragforge:ragforge-secret@localhost:5432/ragforge

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Encryption Key (64-character hex string for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-64-char-hex-key

# Google OAuth (for Gemini provider)
GOOGLE_OAUTH_CLIENT_ID=

# Groq OAuth
GROQ_OAUTH_CLIENT_ID=
GROQ_OAUTH_CLIENT_SECRET=

# Server Port
PORT=8080
