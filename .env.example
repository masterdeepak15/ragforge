# ============================================
# RAGForge configuration
# Copy to .env. `docker compose` and `npm start` both read it.
# ============================================

# --- Required in production -------------------------------------------------

# Signs login tokens. Any random string of 32+ characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Encrypts AI provider credentials at rest. Exactly 64 hex characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes stored provider credentials unreadable; back it up.
ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------

# Public address people use to reach RAGForge (shown in setup instructions).
PUBLIC_URL=http://localhost:8080
PORT=8080

# How many files are indexed at once (default 2). More is faster but hits your embedding provider harder.
INGEST_CONCURRENCY=2

# MCP requests allowed per minute for each API key (default 60).
MCP_RATE_LIMIT=60

# Cap on a single uploaded file, in bytes. Leave unset for no limit.
# MAX_UPLOAD_BYTES=

# --- Local development only -------------------------------------------------

NODE_ENV=development
STORAGE_MODE=sqlite
# SQLITE_URL=file:./ragforge.db
# DATA_DIR=./data

# --- Optional sign-in with Google / Groq -------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GROQ_OAUTH_CLIENT_ID=
GROQ_OAUTH_CLIENT_SECRET=
